# Nullshift monorepo — environment template.
# Copy to apps/<app>/.env.local for local dev (each Next app reads its own .env.local).
# NEVER commit a real .env.local. Only this .env.example is tracked.

# ── Supabase ─────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key (Project Settings → API → service_role). SERVER ONLY — never expose.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Admin allowlist ──────────────────────────────────────
# Comma-separated emails allowed into the admin app. Create these users in
# Supabase → Authentication → Users (Add user → set a password).
ADMIN_EMAILS=louis@nullshift.com

# ── Site URLs (auth email links + cross-app redirects) ───
NEXT_PUBLIC_SITE_URL=https://nullshift.com

# ── Email notifications (Resend) ─────────────────────────
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=Nullshift <confirm@nullshift.com>
ENQUIRY_NOTIFY_EMAIL=louis@nullshift.com
ENQUIRY_FROM_EMAIL=Nullshift <onboarding@resend.dev>
RESEND_AUDIENCE_ID=

# ── Quiz funnel (/start) ─────────────────────────────────
FUNNEL_RESOURCE_URL=https://nullshift.co.uk/resources

# ── Booking (Cal.com) ────────────────────────────────────
# Your Cal.com link, e.g. "nullshift/discovery". When set, an inline booking
# embed appears on /book. Leave empty to use the account/brief booking flow only.
NEXT_PUBLIC_CAL_LINK=

# ── Stripe (billing + Connect platform fee) ──────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# For the Application Fees dashboard (/admin/billing/fees) to update live
# rather than only via its manual Sync button: on this webhook endpoint in
# the Stripe Dashboard, turn on "Listen to events on Connected accounts" and
# add application_fee.created / application_fee.refunded to its event list.

# ── Stripe Connect (client's OWN Stripe account, via OAuth) ──
# Platform Connect client id — Stripe Dashboard → Connect → Settings (ca_...).
# With STRIPE_SECRET_KEY this turns on /api/stripe/connect: the client authorises
# their EXISTING Stripe account (no account is created for them) and the returned
# acct_... is stored on tenants (migration 0051). Unset = the panel on a client's
# Billing tile reads "not configured" and the routes refuse.
STRIPE_CONNECT_CLIENT_ID=
# Where Stripe sends them back. Must match a redirect URI registered on the
# Connect settings EXACTLY. Unset, it is derived as
# <NEXT_PUBLIC_SITE_URL>/api/stripe/oauth/callback — pin it for previews/local.
STRIPE_CONNECT_REDIRECT_URI=https://nullshift.co.uk/api/stripe/oauth/callback
# HMAC key for the OAuth `state` token and the signed connect link we email a
# client. Optional: falls back to STRIPE_SECRET_KEY. Rotating it invalidates
# every connect link already sent (in-flight handshakes must be restarted).
STRIPE_CONNECT_STATE_SECRET=

# ── AI (Anthropic) — powers ops intake triage + inbox ingest parsing ──
ANTHROPIC_API_KEY=sk-ant-your_key

# ── Ops automations ──
# GitHub token with issues:write on client system repos — lets "Dispatch to
# Claude" create an @claude issue that claude-code-action turns into a PR.
# Also needs contents:read on client repos for auto-scoring (public repos work without).
GITHUB_DISPATCH_TOKEN=
# Auto-scoring reads client production databases through the Supabase Management
# API. Personal access token: supabase.com/dashboard/account/tokens. Unset = the
# repository half still runs; the database half is recorded as skipped.
SUPABASE_ACCESS_TOKEN=
# Shared secret protecting /api/cron/* routes (set the same value in vercel.json crons).
CRON_SECRET=
# Shared secret for deploy events (deployment.succeeded → /api/vercel/deploy-hook):
# mirrors every production deployment into the SOC 2 change register. The same
# value goes to the sender — the SOC2_DEPLOY_HOOK_SECRET GitHub repository
# secret (free transport) or the Vercel team webhook (paid plans). Unset here,
# the route answers 503 and nothing is mirrored.
VERCEL_DEPLOY_HOOK_SECRET=

# ── Xero (invoice rail + accounting) ─────────────────────
# developer.xero.com → New app → Custom connection, scopes accounting.invoices,
# accounting.payments, accounting.contacts, accounting.settings.read, authorised
# against the Nullshift organisation. When set,
# invoices are raised in Xero and clients get Xero's online invoice link.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_SALES_ACCOUNT_CODE=200
XERO_PAYMENT_ACCOUNT_CODE=
# GoCardless clearing bank account in Xero — care-plan Direct Debit collections are
# recorded against it (payouts then reconcile as transfers). Falls back to the above.
XERO_GOCARDLESS_ACCOUNT_CODE=
XERO_TAX_TYPE=NONE
# "stripe" keeps Stripe hosted invoices client-facing (Xero stays the mirror).
INVOICE_RAIL=xero
# Operations preview. Independent of OPS_V2_FLAGS; defaults preserve fixture mode.
# Server-only. Never prefix these with NEXT_PUBLIC_.
OPS_REAL_DATA=false
OPS_CLIENT_CREATE=false
